RewriteEngine On

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.classicroadtravels\.in$ [NC]
RewriteRule ^(.*)$ https://classicroadtravels.in/ [R=301,L]

# Redirect index.html to root
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://classicroadtravels.in/ [R=301,L]

# Redirect URLs ending with #
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ https://classicroadtravels.in/ [R=301,L]